{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "^mathiasbooking\\.no$"
        }
      ],
      "destination": "https://www.mathiasbooking.no/:path*",
      "permanent": true
    }
  ]
}
